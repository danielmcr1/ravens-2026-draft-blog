# Local .terraform directories
**/.terraform/*

# .tfstate files (state, sensitive)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Plan output files
*.tfplan

# Sensitive override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc
